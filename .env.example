# ====================
# NTRO GenAI Platform
# Environment Variables
# ====================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# The platform works fully without any variables set.
# Variables marked [Optional] have working defaults or demo modes.

# ==================== AUTH ====================

# JWT signing secret for session tokens
# Auto-generated if not set (tokens won't persist across server restarts)
JWT_SECRET=your-secret-key-here-min-32-chars

# ==================== GOOGLE OAUTH ====================
# [Optional] — falls back to demo mode if not configured
# Get credentials from: https://console.cloud.google.com/apis/credentials
#
# 1. Create a project in Google Cloud Console
# 2. Enable "Google+ API" and "Google Identity Platform"
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add http://localhost:3000 to Authorized JavaScript origins
# 5. Add http://localhost:3000/api/auth/google/callback to Authorized redirect URIs

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==================== BLOCKCHAIN ====================
# [Optional] — uses in-memory simulation if not configured

# Ethereum RPC URL (Infura, Alchemy, or self-hosted node)
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Deployed ContentVerification smart contract address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ==================== AI SERVICES ====================
# [Optional] — uses rule-based transforms if not configured

# OpenAI API key for LLM-powered content generation
OPENAI_API_KEY=sk-your-openai-api-key

# Google Translate API key for multi-language support
GOOGLE_TRANSLATE_KEY=your-google-translate-api-key

# ==================== SECURITY ====================
# [Optional] — all security features work without these

# Encryption key for data at rest (AES-256)
ENCRYPTION_KEY=your-256-bit-encryption-key-here

# SIEM webhook URL for real-time alert forwarding
SIEM_WEBHOOK_URL=https://your-siem-instance.com/api/events

# ==================== DEPLOYMENT ====================
# [Optional] — only needed for production deployment

# Base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database URL (for future PostgreSQL integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/genai_platform
